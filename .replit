modules = ["python-3.12"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["sqlite", "unzip"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Telegram Bot"

[[workflows.workflow]]
name = "Telegram Bot"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m shivu"
waitForPort = 5000

[deployment]
deploymentTarget = "vm"
run = ["python3", "-m", "shivu"]

[[ports]]
localPort = 10000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
